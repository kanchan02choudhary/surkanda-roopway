# Server
PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/surkanda-ropeway
# Comma-separated frontend origins. Set the deployed frontend URL in production.
FRONTEND_URL=http://localhost:5173
ADMIN_API_KEY=replace_with_a_long_random_secret_at_least_24_characters

# Razorpay (use Test Mode keys first; never expose the secret in Vite/frontend)
RAZORPAY_KEY_ID=rzp_test_replace_me
RAZORPAY_KEY_SECRET=replace_me
RAZORPAY_WEBHOOK_SECRET=replace_me

# Email (Resend)
RESEND_API_KEY=re_replace_me
EMAIL_FROM=Surkanda Ropeway <tickets@example.com>
CONTACT_TO=office@example.com
STAFF_NOTIFY_EMAIL=office@example.com

# Ticket price in paise. Counter bill: ₹225 per adult two-way ticket, GST inclusive.
TICKET_PRICE_PAISE=22500
GST_PERCENT=5
MAX_TICKETS_PER_BOOKING=9
BOOKING_MAX_ADVANCE_DAYS=90
TICKET_ITEM_NAME=Adult 2 way

# Confirm cancellation/refund policy with management before production.
CANCELLATION_CUTOFF_HOURS=24
REFUND_PERCENT=100

# Ticket header — verify legal details against original bill/registration.
COMPANY_NAME=Surkanda Devi Ropeway Project Co. P. Ltd.
COMPANY_ADDRESS_1=Kaddukhal, Danaulti Tehri Garhwal,
COMPANY_ADDRESS_2=Uttarakhand - 249145
COMPANY_CIN=U45200UR2013PTC000530
COMPANY_GSTIN=05AASCS5830P1ZL
COMPANY_CONTACT=+91 7060706045
TICKET_HSN=
ONLINE_COUNTER_CODE=99

# ID document retention
DOC_RETENTION_DAYS=30
